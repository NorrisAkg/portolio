// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Article {
  id          String    @id @default(uuid())
  image       String?
  status      String    @default("DRAFT") // DRAFT, PUBLISHED
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tags         Tag[]
  translations ArticleTranslation[]

  @@map("articles")
}

model ArticleTranslation {
  id          String   @id @default(uuid())
  articleId   String
  locale      String   // "fr" ou "en"
  title       String
  slug        String
  description String
  content     String

  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@unique([locale, slug])
  @@map("article_translations")
}

model Project {
  id          String    @id @default(uuid())
  image       String?   // Name of the cover image file (labeled "label" on frontend)
  tone        String    @default("cool") // "warm", "cool", "navy"
  year        String
  dur         String
  githubUrl   String?
  liveUrl     String?
  featured    Boolean   @default(false)
  status      String    @default("DRAFT") // DRAFT, PUBLISHED
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  technologies Technology[]
  translations ProjectTranslation[]

  @@map("projects")
}

model ProjectTranslation {
  id            String   @id @default(uuid())
  projectId     String
  locale        String   // "fr" or "en"
  title         String   // Mapped to project name
  slug          String
  description   String   // Mapped to project "problem"
  content       String   // Project details/writeup
  outcome       String   // Business outcome (e.g. "+38% average margin")
  durationLabel String   // Full duration label (e.g. "8 weeks · MVP → production")

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@unique([locale, slug])
  @@map("project_translations")
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]

  @@map("tags")
}

model Technology {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@map("technologies")
}
